{
  "name": "@runablehq/managed-auth",
  "version": "0.6.0",
  "description": "Runable managed auth — client plugins for web, Expo/React Native, and Electron apps, server plugin for generated apps, broker plugin for the Runable API",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runablehq/runable.git",
    "directory": "packages/managed-auth"
  },
  "files": [
    "dist",
    "src/broker.ts",
    "src/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./desktop/main": {
      "types": "./dist/desktop-main.d.ts",
      "default": "./dist/desktop-main.js"
    },
    "./desktop/preload": {
      "types": "./dist/desktop-preload.d.ts",
      "default": "./dist/desktop-preload.js"
    },
    "./broker": {
      "types": "./src/broker.ts",
      "default": "./src/broker.ts"
    }
  },
  "scripts": {
    "build": "bun src/scripts/build.ts",
    "check-types": "tsc --noEmit",
    "playground": "bun --env-file=playground/.env playground/server.ts",
    "playground:desktop": "cd playground/desktop && bun install --silent && bun run start",
    "playground:mobile": "bun run build && cd playground/mobile && bun install --silent && bunx expo start",
    "format": "bunx oxfmt --write src"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "better-auth": "1.6.23",
    "electron": "^43.0.0",
    "expo-crypto": "~56.0.3",
    "expo-linking": "~56.0.11",
    "expo-secure-store": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "hono": "4.12.25",
    "react-native": "0.85.3"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.19",
    "electron": ">=28",
    "expo-crypto": "*",
    "expo-linking": "*",
    "expo-secure-store": "*",
    "expo-web-browser": "*",
    "hono": ">=4",
    "react-native": "*",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
